#!/usr/bin/env bash
# hwatch — pull food, weight, and read-only activity on a fixed interval.
#
#   ./hwatch                 every 300s, last 7 days
#   ./hwatch 300 --days 30   every 300s, extra args go to `hsync pull --all`
#
# Activity (calories burned, steps, distance, workouts) pulls the last 7
# days and heart rate the last 2, so the final hour of yesterday completes
# after midnight; extra args apply only to food and weight. Run distance is
# derived from workouts. Pull keeps local edits and deletions, so it is safe to
# leave running. A failed pull (network, or another hsync holding the lock) is reported and
# retried on the next tick. Ctrl-C stops it.
set -u
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
interval=300
if [[ ${1:-} =~ ^[0-9]+$ ]]; then
  interval=$1
  shift
fi

trap 'kill $! 2>/dev/null; echo; exit 0' INT TERM
while true; do
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] pull"
  "$here/hsync" pull --all "$@" || echo "pull failed (exit $?); retrying in ${interval}s" >&2
  # Show the latest row and the count, not every row of the window.
  for kind in cal steps distance hr workouts; do
    days=7
    [[ $kind == hr ]] && days=2
    if out=$("$here/hsync" "$kind" pull --days "$days"); then
      printf '\n%s:\n%s\n' "$kind" "$(tail -2 <<<"$out")"
    else
      echo "$kind pull failed (exit $?); retrying in ${interval}s" >&2
    fi
  done
  sleep "$interval" & wait $!
done
