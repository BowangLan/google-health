# ---------------------------------------------------------------------------
# Personal health records stay untracked. Pull can restore synced fields;
# private notes, pending changes, and recovery state need a separate backup.
# ---------------------------------------------------------------------------
/data/

# Credentials ---------------------------------------------------------------
# The OAuth client secret lives at ~/.config/ghealth/client_secret.json; the
# copy below is whatever you dragged out of the Cloud Console during setup.
.env
client_secret*.json
*.apps.googleusercontent.com.json

# Local state ---------------------------------------------------------------
# Derived, machine-specific, and rebuilt on demand.
.fsync-index.json
.fsync-index.migrated*.json
.last-create-response.json

# Your config: local machine paths. config.example.toml is the tracked template.
/config.toml
/.hsync-web.json

# Lavish review artifacts: generated reports for local review only.
/.lavish/

# Local design references.
/docs/design-refs/

# Google's CLI: a clone plus a compiled Go binary, restored by scripts/setup.sh.
/vendor/

# Dependencies and build output ---------------------------------------------
node_modules/
.venv/
.turbo/
dist/
*.tsbuildinfo
test-results/
playwright-report/
.pytest_cache/
.ruff_cache/

# macOS ---------------------------------------------------------------------
.DS_Store

# Python bytecode and per-collection recovery state
__pycache__/
*.py[cod]
.hsync-index.json
.hsync.lock
.*-operations.json
