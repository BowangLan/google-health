# ---------------------------------------------------------------------------
# Personal health records stay untracked. Pull can restore synced fields;
# private notes, pending changes, and recovery state need a separate backup.
# ---------------------------------------------------------------------------
/food/
/weight/

# Credentials ---------------------------------------------------------------
# The OAuth client secret lives at ~/.config/ghealth/client_secret.json; the
# copy below is whatever you dragged out of the Cloud Console during setup.
.env
client_secret*.json
*.apps.googleusercontent.com.json

# Local state ---------------------------------------------------------------
# Derived, machine-specific, and rebuilt on demand.
.fsync-index.json
.fsync-index.migrated*.json
.last-create-response.json

# Your config: local machine paths. fsync.toml.example is the tracked template.
/fsync.toml
/hsync.toml

# Google's CLI: a clone plus a compiled Go binary, restored by setup-wizard.sh.
/google-health-cli/

# macOS ---------------------------------------------------------------------
.DS_Store

# Python bytecode and per-collection recovery state
__pycache__/
*.py[cod]
.hsync-index.json
.hsync.lock
.*-operations.json
