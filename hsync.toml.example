# Copy to hsync.toml. Relative paths resolve against this file.
# Existing fsync.toml files and FSYNC_FOOD_DIR continue to work.
# hsync.toml takes precedence when both configuration files exist.

# food_dir = "~/Dropbox/health/food"
# weight_dir = "~/Dropbox/health/weight"
# timezone = "America/Los_Angeles"
# weight_unit = "kg"                    # kg or lb; input/display only
# ghealth = "/usr/local/bin/ghealth"

# Each collection owns its index; keeping defaults is recommended.
# food_index = "food/.fsync-index.json"
# weight_index = "weight/.hsync-index.json"
# Legacy `index` is a food-only alias for food_index.
